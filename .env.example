# ==============================================================================
# NEPTUNE-AI SYSTEM CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and adjust variables for your local deployment:
#   cp .env.example .env
# NEVER commit the active .env file containing live credentials to git.
# ==============================================================================

# --- System & Network ---
NODE_ENV=production
NEPTUNE_HOST=0.0.0.0
NEPTUNE_PORT=3000
# Standard RFC 8375 local home domain (configured in router / local DNS):
NEPTUNE_DOMAIN=neptune.home.arpa
LOG_LEVEL=info

# --- Reverse Proxy & TLS Gateway (Caddy) ---
# Options: 'internal' (Caddy automated local CA) or your custom domain name
CADDY_TLS_MODE=internal

# --- Local LLM Engine (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
# Primary model: Alibaba Qwen 2.5 3B (Validated 20/20 tool-calling accuracy on CPU)
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2
LLM_CONTEXT_WINDOW=4096

# --- Speech-to-Text Subsystem (Wyoming Whisper) ---
WHISPER_HOST=whisper
WHISPER_PORT=10300
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# --- Text-to-Speech Subsystem (Wyoming Piper) ---
PIPER_HOST=piper
PIPER_PORT=10200
PIPER_VOICE=en_US-lessac-medium

# --- Home Assistant Integration ---
# Base URL for Home Assistant (e.g., http://homeassistant.local:8123 or http://192.168.1.X:8123)
HOMEASSISTANT_URL=http://homeassistant.local:8123
# Long-Lived Access Token created in Home Assistant: Profile -> Long-Lived Access Tokens
HOMEASSISTANT_TOKEN=your_ha_long_lived_access_token_here

# Target Entity IDs for Living Room / Whole-House (must also appear in config/allowed_entities.json)
TV_ENTITY_ID=media_player.living_room_lg_webos_tv_qned806qa
SPEAKER_ENTITY_ID=media_player.living_room_vlc_telnet

# --- Media Server Integration (Jellyfin) ---
# Base URL for Jellyfin Media Server (e.g., http://jellyfin.local:8096 or http://192.168.1.X:8096)
JELLYFIN_URL=http://jellyfin.local:8096
# API Key generated in Jellyfin Dashboard -> Advanced -> Keys
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# --- Telephony & PBX (Asterisk) ---
ASTERISK_HOST=asterisk
ASTERISK_PORT=5060
ASTERISK_SPOOL_DIR=/var/spool/asterisk/outgoing
SIP_EXT_PRIMARY=1001
SIP_EXT_SECONDARY=1002
SIP_EXT_OPERATOR=7000

# --- User Identity & Personalization ---
# Name used for personalized greetings and contact matching
PRIMARY_USER_NAME=Primary

# --- Persistent Storage & Security ---
DATA_DIR=/app/data
ALLOWED_ENTITIES_PATH=/app/config/allowed_entities.json
# Optional API key to protect /api/* routes via X-API-Key or Bearer token (leave blank on trusted LAN)
NEPTUNE_API_KEY=

# Reserved for planned v0.2.0 SQLite & interactive confirmation features (currently unused):
DATABASE_PATH=/app/data/neptune.sqlite
SESSION_SECRET=generate_a_random_32_byte_hex_string_here
REQUIRE_CONFIRMATION_TIMEOUT_SECONDS=30
