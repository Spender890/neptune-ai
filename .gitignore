# ==============================================================================
# NEPTUNE-AI: Version Control Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
package-lock.json.bak

# Production Build Outputs
backend/dist/
backend/dist-test/
*.tsbuildinfo

# Environment & Credentials (NEVER commit secrets or live env files)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.pfx
*.cert
*credentials*
*.production*

# Persistent Runtime Data & Databases
data/
*.sqlite
*.sqlite3
*.db
reminders.json
config/contacts.json

# Asterisk Telephony Audio & Temporary Spool Files
*.wav
*.mp3
*.ogg
*.pcm
*.call
asterisk/spool/
var/spool/
data/outgoing/

# System & Editor Caches
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
