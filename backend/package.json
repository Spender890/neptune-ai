{
  "name": "neptune-backend",
  "version": "0.1.0",
  "description": "Neptune-AI Core Backend Engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/neptune.test.js",
    "test:native": "node --import ./test/ts-loader.mjs --test test/neptune.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
